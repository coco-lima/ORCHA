# AI Agent Orchestration Platform - Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# WebSocket Configuration
WS_PORT=3002

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# External Application APIs
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
GITHUB_TOKEN=your_github_token_here
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_BASE_URL=your_jira_instance_url_here
NOTION_API_KEY=your_notion_api_key_here

# Database Configuration (Optional - for persistent storage)
DATABASE_URL=postgresql://username:password@localhost:5432/ai_orchestrator
REDIS_URL=redis://localhost:6379

# Email Service (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Cloud Storage (for file handling)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket_name_here

# Authentication (if needed)
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Monitoring & Analytics
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_API_KEY=your_analytics_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Demo Mode Configuration
DEMO_MODE=true
DEMO_DELAY_MS=2000
DEMO_AUTO_START=false

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
